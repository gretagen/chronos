#!/bin/bash
# chronos — btrfs generation manager for Haliade system (Limine boot entries)
set -euo pipefail

# Only operations that change generations or the boot configuration need
# superuser privileges. Everything else runs as any user: the read-only
# commands (list, current, help) and any invocation chronos itself rejects
# with a usage error.
case "${1:-help}" in
    create|rollback|remove|rewrite-limine|rewrite_limine|cleanup-next|cleanup_next)
        if [ "${EUID:-$(id -u)}" -ne 0 ]; then
            echo "Managing generations requires superuser privileges." >&2
            exit 1
        fi
        ;;
esac


SNAP_MOUNT="${CHRONOS_SNAP_MOUNT:-/.snapshots}"
LIMINE_CONF="${CHRONOS_LIMINE:-/boot/limine.conf}"
LIVE_SUBVOL="@"
SNAPS_SUBVOL="@snapshots"
NEXT_SUBVOL="@.next"
# init identity db, shared with iniswap and the shutdown/reboot wrappers
# (overridable for tests)
INIT_DB="${CHRONOS_INIT_DB:-/var/db/init}"

# Helpers

die() { echo "error: $*" >&2; exit 1; }
info() { echo "[info] $*"; }
ok() { echo "[ok] $*"; }
warn() { echo "warning: $*" >&2; }

root_device() {
    findmnt -n -o SOURCE / 2>/dev/null | sed 's/\[.*\]//' | head -1
}

root_uuid() {
    findmnt -n -o UUID / 2>/dev/null || true
}

root_partuuid() {
    findmnt -n -o PARTUUID / 2>/dev/null || true
}

root_spec() {
    local u p dev
    u=$(root_uuid)
    if [ -n "$u" ]; then
        echo "UUID=$u"
        return
    fi
    p=$(root_partuuid)
    if [ -n "$p" ]; then
        echo "PARTUUID=$p"
        return
    fi
    dev=$(root_device)
    [ -n "$dev" ] || die "could not determine root device"
    echo "$dev"
}

current_subvol() {
    local src opt
    src=$(findmnt -n -o SOURCE / 2>/dev/null || true)
    case "$src" in
        *\[*\])
            src=${src#*\[}
            src=${src%\]*}
            # strip leading /
            src=${src#/}
            echo "$src"
            return
            ;;
    esac
    opt=$(findmnt -n -o OPTIONS / 2>/dev/null | tr ',' '\n' | sed -n 's/^subvol=\///p; s/^subvol=//p' | head -1)
    echo "$opt"
}

find_kernel() {
    local candidates=()
    local k
    for k in /boot/vmlinuz-*; do
        [ -f "$k" ] || continue
        candidates+=("$k")
    done
    if [ ${#candidates[@]} -gt 0 ]; then
        # Sort by version (highest last) and return the latest
        local latest
        latest=$(printf '%s\n' "${candidates[@]}" | sort -V | tail -1)
        basename "$latest"
        return 0
    fi
    # Fallback to generic names
    for k in /boot/vmlinuz /boot/bzImage; do
        [ -f "$k" ] || continue
        basename "$k"
        return 0
    done
    return 1
}

find_initrd() {
    local kernel_ver="${1:-}"
    local candidates=()
    local i

    # If kernel version provided, look for matching initramfs first
    if [ -n "$kernel_ver" ]; then
        for i in "/boot/initramfs-${kernel_ver}.img" "/boot/initrd-${kernel_ver}" "/boot/initrd-${kernel_ver}.img"; do
            [ -f "$i" ] || continue
            basename "$i"
            return 0
        done
    fi

    # The current image name wins over anything else in /boot: a reinstall
    # target can still carry the pre-rename initramfs-installed.img, and the
    # version sort below ranks "installed" above "core", which would keep boot
    # entries pointing at the stale file forever.
    if [ -f /boot/initramfs-core.img ]; then
        basename /boot/initramfs-core.img
        return 0
    fi

    # Collect all initramfs candidates, skipping the pre-rename legacy name
    # (kept only as a last resort below, so an uncleaned target still boots).
    for i in /boot/initramfs-*.img; do
        [ -f "$i" ] || continue
        [ "$i" = "/boot/initramfs-installed.img" ] && continue
        candidates+=("$i")
    done
    if [ ${#candidates[@]} -gt 0 ]; then
        # Sort by version (highest last) and return the latest
        local latest
        latest=$(printf '%s\n' "${candidates[@]}" | sort -V | tail -1)
        basename "$latest"
        return 0
    fi

    # Fallback to generic names; initramfs-installed.img is the pre-rename
    # image, accepted here only when nothing else exists so old targets still
    # boot until the installer has cleaned them up.
    for i in /boot/initramfs-installed.img /boot/initrd.img* /boot/initrd-*; do
        [ -f "$i" ] || continue
        basename "$i"
        return 0
    done
    return 1
}

# Newest kernel version with modules at the given root path, or "". Kernel
# versions are the directories in lib/modules (e.g. 6.18.10-gen); anything
# not starting with a digit (build/, source/, extramodules-*) is not a
# kernel we can boot.
modules_kernel() {
    ls -1 "$1/lib/modules/" 2>/dev/null | sed -n '/^[0-9]/p' | sort -V | tail -1 || true
}

# Kernel a generation boots with. A generation snapshot is read-only, so the
# newest module dir inside it is the kernel that generation ran when it was
# captured — and the only one it can boot with drivers. Newer generations
# record it in meta.toml at create time; legacy ones fall back to the scan
# above. Returns the vmlinuz basename, or nothing.
generation_kernel() {
    local gen="$1" ver
    ver=$(load_meta_kernel "$gen")
    if [ -z "$ver" ]; then
        ver=$(modules_kernel "$SNAP_MOUNT/$gen")
    fi
    [ -n "$ver" ] || return 1
    [ -f "/boot/vmlinuz-$ver" ] || return 1
    echo "vmlinuz-$ver"
}

# Kernel for the default /Haliade SYS entry: the newest kernel that the
# entry's target subvolume actually has modules for. After a kernel upgrade
# that is the new kernel (live @ was just upgraded), but when a rollback is
# staged it is the rolled-back kernel (@.next) — so a rollback never boots a
# kernel whose modules are missing from the subvolume it boots. Falls back
# to the newest kernel in /boot.
default_kernel() {
    local subvol="$1" tl ver=""
    tl=$(mount_toplevel 2>/dev/null) || true
    if [ -n "$tl" ]; then
        ver=$(modules_kernel "$tl/$subvol")
        umount "$tl" 2>/dev/null || true
        rmdir "$tl" 2>/dev/null || true
    fi
    [ -n "$ver" ] && [ -f "/boot/vmlinuz-$ver" ] && { echo "vmlinuz-$ver"; return 0; }
    find_kernel || true
}

mount_toplevel() {
    local dev tmp
    dev=$(root_device)
    [ -n "$dev" ] || die "could not detect root device (is / on btrfs?)"
    tmp=$(mktemp -d /tmp/chronos-tl.XXXXXX)
    if ! mount -t btrfs -o subvol=/ "$dev" "$tmp" 2>/dev/null; then
        rmdir "$tmp" 2>/dev/null || true
        die "failed to mount btrfs top-level on $dev"
    fi
    echo "$tmp"
}

ensure_layout() {
    local tl
    tl=$(mount_toplevel)
    if [ ! -d "$tl/$LIVE_SUBVOL" ] && [ ! -d "$tl/$NEXT_SUBVOL" ]; then
        umount "$tl" 2>/dev/null || true
        rmdir "$tl" 2>/dev/null || true
        die "missing subvolume '$LIVE_SUBVOL' — reinstall with current zstrappa or create layout manually"
    fi
    if [ ! -d "$tl/$SNAPS_SUBVOL" ]; then
        info "creating $SNAPS_SUBVOL subvolume..."
        btrfs subvolume create "$tl/$SNAPS_SUBVOL" \
            || { umount "$tl"; rmdir "$tl"; die "failed to create $SNAPS_SUBVOL"; }
    fi
    umount "$tl"
    rmdir "$tl" 2>/dev/null || true
}

ensure_snapshots_mounted() {
    ensure_layout
    mkdir -p "$SNAP_MOUNT"
    if mountpoint -q "$SNAP_MOUNT" 2>/dev/null; then
        return 0
    fi
    local dev
    dev=$(root_device)
    mount -t btrfs -o "subvol=$SNAPS_SUBVOL" "$dev" "$SNAP_MOUNT" \
        || die "failed to mount $SNAPS_SUBVOL on $SNAP_MOUNT"
}

# The reporting commands (list, current) run without superuser privileges, so
# they must never mount or create anything: a normal user reads whatever is
# already on $SNAP_MOUNT, while root can still fall back to the setup above.
mount_for_reading() {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        [ -d "$SNAP_MOUNT" ] || return 1
        return 0
    fi
    ensure_snapshots_mounted
}

resolve_id() {
    local input="$1" name
    if [[ "$input" =~ ^[0-9]+$ ]]; then
        name="gen-$input"
    elif [[ "$input" =~ ^gen-[0-9]+$ ]]; then
        name="$input"
    else
        die "invalid generation id '$input' (use N or gen-N)"
    fi
    [ -d "$SNAP_MOUNT/$name" ] || die "generation '$name' not found"
    echo "$name"
}

next_id() {
    local n=1
    while [ -d "$SNAP_MOUNT/gen-$n" ]; do
        n=$((n + 1))
    done
    echo "$n"
}

write_meta_file() {
    local path="$1" id="$2" desc="$3" cmdline="$4" kernel="$5" ts
    ts=$(date +%s)
    # escape quotes in description and cmdline
    desc=${desc//\"/\\\"}
    cmdline=${cmdline//\"/\\\"}
    cat > "$path" <<EOF
id = "$id"
timestamp = $ts
description = "$desc"
cmdline = "$cmdline"
kernel = "$kernel"
EOF
}

meta_path() {
    local id="$1"
    if [ -f "$SNAP_MOUNT/$id/meta.toml" ]; then
        echo "$SNAP_MOUNT/$id/meta.toml"
    else
        echo "$SNAP_MOUNT/${id}.meta.toml"
    fi
}

load_meta_desc() {
    local f
    f=$(meta_path "$1")
    [ -f "$f" ] || return 0
    sed -n 's/^description = "\(.*\)"/\1/p' "$f" | head -1
}

load_meta_ts() {
    local f
    f=$(meta_path "$1")
    [ -f "$f" ] || return 0
    sed -n 's/^timestamp = //p' "$f" | head -1
}

load_meta_cmdline() {
    local f
    f=$(meta_path "$1")
    [ -f "$f" ] || return 0
    sed -n 's/^cmdline = "\(.*\)"/\1/p' "$f" | head -1
}

load_meta_kernel() {
    local f
    f=$(meta_path "$1")
    [ -f "$f" ] || return 0
    sed -n 's/^kernel = "\(.*\)"/\1/p' "$f" | head -1
}

# Recorded cmdline for a generation; empty for legacy generations without
# one. Also heals older metas that stored the entry's indentation and a
# duplicated "cmdline:" key (they were emitted as "cmdline:     cmdline:").
gen_cmdline() {
    local c
    c=$(load_meta_cmdline "$1")
    printf '%s' "$c" \
        | sed -e 's/^[[:space:]]*//' -e 's/^cmdline:[[:space:]]*//' \
              -e 's/^[[:space:]]*//' -e 's/^cmdline:[[:space:]]*//'
}

read_current() {
    if [ -f "$SNAP_MOUNT/.current" ]; then
        tr -d '[:space:]' < "$SNAP_MOUNT/.current"
    fi
}

set_current() {
    printf '%s\n' "$1" > "$SNAP_MOUNT/.current"
}

# Extras = cmdline tokens except root/rootflags/rw/ro (and stray keys).
extras_from() {
    local line="$1" extras="" tok
    for tok in $line; do
        case "$tok" in
            root=*|rootflags=*|rw|ro) ;;
            # stray duplicated key from a bad capture — never an extra
            cmdline:*) ;;
            *) extras="${extras:+$extras }$tok" ;;
        esac
    done
    echo "$extras"
}

cmdline_extras() {
    local conf="$LIMINE_CONF" line
    [ -f "$conf" ] || { echo ""; return 0; }
    line=$(grep -m1 '^[[:space:]]*cmdline:' "$conf" 2>/dev/null || true)
    line=${line#*cmdline:}
    line=$(echo "$line" | sed 's/^[[:space:]]*//')
    extras_from "$line"
}

# extras with any init= token removed — used for legacy generations that
# have no recorded cmdline: they must boot the default init, not whichever
# one happens to be active now.
strip_init() {
    local out="" tok
    for tok in $1; do
        case "$tok" in
            init=*) ;;
            *) out="${out:+$out }$tok" ;;
        esac
    done
    echo "$out"
}

# Init name declared by a cmdline string ("openrc" when there is no init=
# at all, since that is the Haliade default). Anchored to whitespace so
# params like "reinit=5" don't false-match.
init_name_of() {
    local p
    p=$(printf ' %s' "$1" | sed -n 's/.*[[:space:]]init=\([^ ]*\).*/\1/p')
    case "$p" in
        */runit-init|*/runit) echo "runit" ;;
        */dinit)             echo "dinit" ;;
        */openrc-init)       echo "openrc" ;;
        */systemd)            echo "systemd" ;;
        "")                  echo "openrc" ;;
        *)                   echo "unknown" ;;
    esac
}

# Align /var/db/init with the init a rollback will boot (same ordering as
# iniswap's record_init_state: current <- new, previous <- old current), so
# the universal shutdown/reboot wrappers pick the right tool right after
# the rollback boot — without waiting for the next declaration sync.
update_init_db() {
    local new_init old=""
    new_init=$(init_name_of "$1")
    [ "$new_init" != "unknown" ] || return 0
    mkdir -p "$INIT_DB"
    if [ -s "$INIT_DB/current" ]; then
        old=$(tr -d '[:space:]' < "$INIT_DB/current")
        if [ -n "$old" ] && [ "$old" != "$new_init" ]; then
            printf '%s\n' "$old" > "$INIT_DB/previous"
        fi
    fi
    printf '%s\n' "$new_init" > "$INIT_DB/current"
}

limine_global() {
    local key="$1" default="$2" conf="$LIMINE_CONF" val
    if [ -f "$conf" ]; then
        val=$(grep -m1 "^${key}:" "$conf" 2>/dev/null | sed "s/^${key}:[[:space:]]*//" || true)
        if [ -n "$val" ]; then
            echo "$val"
            return
        fi
    fi
    echo "$default"
}

# Default live subvolume for the primary Limine entry (@ or @.next after pending rollback)
default_live_subvol() {
    local conf="$LIMINE_CONF" flags
    if [ -f "$conf" ]; then
        flags=$(grep -m1 '^[[:space:]]*cmdline:' "$conf" 2>/dev/null | grep -o 'rootflags=subvol=[^ ]*' | head -1 || true)
        flags=${flags#rootflags=subvol=}
        case "$flags" in
            @|"$LIVE_SUBVOL") echo "$LIVE_SUBVOL"; return ;;
            @.next|"$NEXT_SUBVOL") echo "$NEXT_SUBVOL"; return ;;
        esac
    fi
    local booted
    booted=$(current_subvol)
    case "$booted" in
        "$NEXT_SUBVOL"|@.next) echo "$NEXT_SUBVOL" ;;
        *) echo "$LIVE_SUBVOL" ;;
    esac
}

# Limine rewrite

rewrite_limine() {
    local live_subvol="${1:-}"
    local extras_override="${2:-}"
    ensure_snapshots_mounted

    if [ -z "$live_subvol" ]; then
        live_subvol=$(default_live_subvol)
    fi

    local kernel initrd kernel_ver rspec extras timeout serial wallpaper
    kernel=$(find_kernel) || die "no kernel found in /boot"
    # Extract version from kernel filename (vmlinuz-X.Y.Z-gen -> X.Y.Z-gen)
    kernel_ver="${kernel#vmlinuz-}"
    initrd=$(find_initrd "$kernel_ver") || die "no initramfs found in /boot"

    # Pin the DEFAULT entry to the kernel the booted subvolume has modules
    # for. That is normally the newest kernel (live @ is upgraded by
    # genkernel), but after a staged rollback it is the rolled-back kernel
    # (@.next) — otherwise the rollback would boot a kernel whose modules
    # are not in that subvolume: no drivers, no network.
    local live_kernel live_initrd live_ver
    live_kernel=$(default_kernel "$live_subvol") || true
    [ -n "$live_kernel" ] || live_kernel="$kernel"
    live_ver="${live_kernel#vmlinuz-}"
    live_initrd=$(find_initrd "$live_ver") || live_initrd="$initrd"
    rspec=$(root_spec)
    # $2 overrides the extras (including init=) used for the LIVE entry:
    # cmd_rollback passes the target generation's recorded extras so a
    # rollback also rolls the boot entry's init= back to what that
    # generation recorded. Default: keep the current main entry's extras.
    if [ -n "$extras_override" ]; then
        extras="$extras_override"
    else
        extras=$(cmdline_extras)
    fi
    timeout=$(limine_global "timeout" "15")
    serial=$(limine_global "serial" "yes")
    wallpaper=$(limine_global "wallpaper" "")

    local live_cmd gen_cmd
    live_cmd="root=${rspec} rootflags=subvol=${live_subvol} rw"
    [ -n "$extras" ] && live_cmd="$live_cmd $extras"

    # extras minus init=: only the live entry declares the active init.
    # Legacy generations without a stored cmdline must fall back to the
    # default init instead of inheriting whichever one is active now.
    local extras_no_init="" tok
    for tok in $extras; do
        case "$tok" in
            init=*) ;;
            *) extras_no_init="${extras_no_init:+$extras_no_init }$tok" ;;
        esac
    done

    local tmp name num
    tmp=$(mktemp)
    {
        echo "# Limine configuration for this Haliade system, managed by chronos"
        echo "# Do not hand-edit generation entries; run: chronos rewrite-limine"
        echo
        echo "timeout: $timeout"
        echo "serial: $serial"
        if [ -n "$wallpaper" ]; then
            echo "wallpaper: $wallpaper"
            echo "wallpaper_style: stretched"
        fi
        echo
        echo "/Haliade SYS"
        echo "    protocol: linux"
        echo "    kernel_path: boot():/${live_kernel}"
        echo "    module_path: boot():/${live_initrd}"
        echo "    cmdline: $live_cmd"
        echo

        local gens=()
        local d
        for d in "$SNAP_MOUNT"/gen-*; do
            [ -d "$d" ] || continue
            gens+=("$(basename "$d")")
        done

        if [ ${#gens[@]} -gt 0 ]; then
            IFS=$'\n' gens=($(printf '%s\n' "${gens[@]}" | sort -t- -k2 -n))
            unset IFS

            echo "/Generations"
            for name in "${gens[@]}"; do
                num=${name#gen-}
                gen_cmd=$(gen_cmdline "$name")
                # Fallback for legacy gens without stored cmdline: no init=,
                # so they boot the default init (never the currently-active one)
                [ -z "$gen_cmd" ] && gen_cmd="root=${rspec} rootflags=subvol=${SNAPS_SUBVOL}/${name} rw${extras_no_init:+ $extras_no_init}"
                local desc

                # Pin this generation to the kernel ITS snapshot has modules
                # for. Rewriting every entry with the newest kernel would make
                # a rollback boot a kernel whose module dir is not in the
                # generation — no drivers, no network.
                local gen_kernel gen_initrd gen_ver
                gen_kernel=$(generation_kernel "$name") || true
                if [ -n "$gen_kernel" ]; then
                    gen_ver="${gen_kernel#vmlinuz-}"
                    gen_initrd=$(find_initrd "$gen_ver") || gen_initrd="$initrd"
                else
                    warn "generation $name: no kernel with modules found — using newest kernel ($kernel)"
                    gen_kernel="$kernel"
                    gen_initrd="$initrd"
                fi

                desc=$(load_meta_desc "$name")
                desc=${desc:-"(no description)"}
                echo "    //Generation ${num} — ${desc}"
                echo "        protocol: linux"
                echo "        kernel_path: boot():/${gen_kernel}"
                echo "        module_path: boot():/${gen_initrd}"
                echo "        cmdline: $gen_cmd"
            done
        fi
    } > "$tmp"

    mkdir -p "$(dirname "$LIMINE_CONF")"
    mv "$tmp" "$LIMINE_CONF"
    ok "wrote $LIMINE_CONF (default subvol=${live_subvol})"
}

# Commands

cmd_create() {
    local desc="${1:-}"
    [ -n "$desc" ] || die "missing description (usage: chronos create <description>)"

    # If we previously rolled back to @.next and are now running on it, adopt first
    cmd_adopt_if_needed

    ensure_snapshots_mounted

    local n id tl source_subvol
    n=$(next_id)
    id="gen-$n"

    source_subvol=$(current_subvol)
    case "$source_subvol" in
        "$LIVE_SUBVOL"|@|"$NEXT_SUBVOL"|@.next) ;;
        "$SNAPS_SUBVOL"/*|@snapshots/*)
            die "refusing to snapshot a read-only generation boot; boot into Haliade system first"
            ;;
        "") source_subvol="$LIVE_SUBVOL" ;;
    esac

    info "creating generation $id from $source_subvol ($desc)..."

    # Capture the full current cmdline from limine.conf (first cmdline line =
    # the default /Haliade SYS entry). Strip the entry indentation AND any
    # stray "cmdline:" key prefix: the line looks like "    cmdline: root=...",
    # and a capture that keeps the indent poisons every rewrite afterwards.
    local cur_cmdline
    cur_cmdline=$(grep -m1 '^[[:space:]]*cmdline:' "$LIMINE_CONF" 2>/dev/null \
        | sed -e 's/^[[:space:]]*cmdline:[[:space:]]*//' \
              -e 's/^[[:space:]]*//' \
              -e 's/^cmdline:[[:space:]]*//' || true)

    tl=$(mount_toplevel)
    if [ ! -d "$tl/$source_subvol" ]; then
        # fall back to @
        source_subvol="$LIVE_SUBVOL"
    fi
    if ! btrfs subvolume snapshot -r "$tl/$source_subvol" "$tl/$SNAPS_SUBVOL/$id"; then
        umount "$tl"; rmdir "$tl" 2>/dev/null || true
        die "btrfs snapshot failed"
    fi
    umount "$tl"
    rmdir "$tl" 2>/dev/null || true

    # RO snapshot: store metadata beside the snap. Record the kernel the
    # snapshot boots with (its newest module dir) so limine.conf rewrites
    # pin this generation to its own kernel rather than the newest one.
    local kernel_ver
    kernel_ver=$(modules_kernel /) || true
    write_meta_file "$SNAP_MOUNT/${id}.meta.toml" "$id" "$desc" "$cur_cmdline" "$kernel_ver"

    set_current "$id"
    rewrite_limine
    ok "generation $id created: $desc"
}

cmd_list() {
    mount_for_reading 2>/dev/null || {
        info "no generations found"
        return 0
    }

    local current name num desc ts marker
    current=$(read_current)

    local names=()
    local d
    for d in "$SNAP_MOUNT"/gen-*; do
        [ -d "$d" ] || continue
        names+=("$(basename "$d")")
    done

    if [ ${#names[@]} -eq 0 ]; then
        info "no generations found in $SNAP_MOUNT"
        return 0
    fi

    IFS=$'\n' names=($(printf '%s\n' "${names[@]}" | sort -t- -k2 -n))
    unset IFS

    printf '%s  %-12s  %-20s  %s\n' " " "ID" "DATE" "DESCRIPTION"
    for name in "${names[@]}"; do
        num=${name#gen-}
        desc=$(load_meta_desc "$name")
        desc=${desc:-"(no description)"}
        ts=$(load_meta_ts "$name")
        if [ -n "$ts" ]; then
            ts=$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$ts")
        else
            ts=$(date -r "$SNAP_MOUNT/$name" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "unknown")
        fi
        if [ "$name" = "$current" ]; then
            marker="*"
        else
            marker=" "
        fi
        printf '%s  %-12s  %-20s  %s\n' "$marker" "gen-$num" "$ts" "$desc"
    done
}

cmd_current() {
    mount_for_reading 2>/dev/null || true
    local id desc ts sub
    id=$(read_current 2>/dev/null || true)
    sub=$(current_subvol)
    if [ -z "${id:-}" ]; then
        info "no current generation set"
        [ -n "$sub" ] && echo "booted subvolume: $sub"
        return 0
    fi
    desc=$(load_meta_desc "$id")
    ts=$(load_meta_ts "$id")
    if [ -n "$ts" ]; then
        ts=$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$ts")
    fi
    echo "current: $id"
    [ -n "$ts" ] && echo "date:    $ts"
    [ -n "$desc" ] && echo "desc:    $desc"
    [ -n "$sub" ] && echo "booted:  $sub"
    # Informational only: the exit status must not depend on which fields
    # happened to be known (an empty booted subvolume made this exit 1).
    return 0
}

# If booted from @.next after a deferred rollback, promote it to @.
cmd_adopt_if_needed() {
    local booted tl
    booted=$(current_subvol)
    case "$booted" in
        "$NEXT_SUBVOL"|@.next) ;;
        *) return 0 ;;
    esac

    info "adopting $NEXT_SUBVOL as $LIVE_SUBVOL..."
    tl=$(mount_toplevel)
    # Old @ is unused (we're on @.next)
    if [ -d "$tl/$LIVE_SUBVOL" ]; then
        btrfs subvolume delete "$tl/$LIVE_SUBVOL" 2>/dev/null \
            || btrfs subvolume snapshot -r "$tl/$LIVE_SUBVOL" "$tl/@.old-$(date +%s)" 2>/dev/null || true
        btrfs subvolume delete "$tl/$LIVE_SUBVOL" 2>/dev/null || true
    fi
    # btrfs cannot rename subvolumes; snapshot @.next -> @ then delete @.next later
    if [ ! -d "$tl/$LIVE_SUBVOL" ]; then
        btrfs subvolume snapshot "$tl/$NEXT_SUBVOL" "$tl/$LIVE_SUBVOL" \
            || { umount "$tl"; rmdir "$tl"; die "failed to promote $NEXT_SUBVOL to $LIVE_SUBVOL"; }
    fi
    umount "$tl"
    rmdir "$tl" 2>/dev/null || true

    # Still running on @.next until reboot; point default boot back at @
    rewrite_limine "$LIVE_SUBVOL"
    ok "promoted rollback to $LIVE_SUBVOL — reboot once more to drop $NEXT_SUBVOL"
    info "after reboot you may run: chronos cleanup-next"
}

cmd_cleanup_next() {
    local booted tl
    booted=$(current_subvol)
    case "$booted" in
        "$NEXT_SUBVOL"|@.next)
            die "still booted from $NEXT_SUBVOL; boot into Haliade system (@) first"
            ;;
    esac
    tl=$(mount_toplevel)
    if [ -d "$tl/$NEXT_SUBVOL" ]; then
        btrfs subvolume delete "$tl/$NEXT_SUBVOL" \
            || { umount "$tl"; rmdir "$tl"; die "failed to delete $NEXT_SUBVOL"; }
        ok "deleted $NEXT_SUBVOL"
    else
        info "no $NEXT_SUBVOL to clean"
    fi
    umount "$tl"
    rmdir "$tl" 2>/dev/null || true
    rewrite_limine "$LIVE_SUBVOL"
}

cmd_rollback() {
    local raw="${1:-}"
    [ -n "$raw" ] || die "missing generation id (usage: chronos rollback <N>)"

    ensure_snapshots_mounted
    local id gen_cmd extras_override
    id=$(resolve_id "$raw")

    # The rolled-back boot must use the init THAT generation recorded: the
    # snapshot's filesystem only has that init installed, so keeping the
    # current init= leaves the machine unbootable (e.g. rolling back to a
    # pre-dinit generation while init=/sbin/dinit). A legacy generation
    # without a recorded cmdline falls back to the default init (no init=).
    gen_cmd=$(gen_cmdline "$id")
    if [ -n "$gen_cmd" ]; then
        extras_override=$(extras_from "$gen_cmd")
    else
        extras_override=$(strip_init "$(cmdline_extras)")
    fi

    local booted tl
    booted=$(current_subvol)

    # Recovery path: booted from a generation — can replace @ directly
    case "$booted" in
        "$SNAPS_SUBVOL"/*|@snapshots/*)
            info "booted from snapshot; replacing live $LIVE_SUBVOL with $id..."
            tl=$(mount_toplevel)
            if [ -d "$tl/$LIVE_SUBVOL" ]; then
                btrfs subvolume delete "$tl/$LIVE_SUBVOL" \
                    || { umount "$tl"; rmdir "$tl"; die "failed to delete $LIVE_SUBVOL"; }
            fi
            # drop stale @.next
            [ -d "$tl/$NEXT_SUBVOL" ] && btrfs subvolume delete "$tl/$NEXT_SUBVOL" 2>/dev/null || true
            btrfs subvolume snapshot "$tl/$SNAPS_SUBVOL/$id" "$tl/$LIVE_SUBVOL" \
                || { umount "$tl"; rmdir "$tl"; die "failed to snapshot $id -> $LIVE_SUBVOL"; }
            umount "$tl"
            rmdir "$tl" 2>/dev/null || true
            set_current "$id"
            rewrite_limine "$LIVE_SUBVOL" "$extras_override"
            update_init_db "$extras_override"
            ok "rolled back to $id , you can reboot ,ow"
            return 0
            ;;
    esac

    # Live path: cannot delete mounted @ — stage @.next and switch default boot
    info "staging rollback of $id as $NEXT_SUBVOL (live $LIVE_SUBVOL is mounted)..."
    tl=$(mount_toplevel)

    if [ -d "$tl/$NEXT_SUBVOL" ]; then
        btrfs subvolume delete "$tl/$NEXT_SUBVOL" 2>/dev/null || true
    fi
    btrfs subvolume snapshot "$tl/$SNAPS_SUBVOL/$id" "$tl/$NEXT_SUBVOL" \
        || { umount "$tl"; rmdir "$tl"; die "failed to create $NEXT_SUBVOL from $id"; }
    umount "$tl"
    rmdir "$tl" 2>/dev/null || true

    set_current "$id"
    rewrite_limine "$NEXT_SUBVOL" "$extras_override"
    update_init_db "$extras_override"
    ok "rollback staged: next boot uses $NEXT_SUBVOL (from $id)"
    info "You can reboot now."
}

cmd_remove() {
    local raw="${1:-}"
    [ -n "$raw" ] || die "missing generation id (usage: chronos remove <N>)"

    ensure_snapshots_mounted
    local id current booted
    id=$(resolve_id "$raw")
    current=$(read_current)
    booted=$(current_subvol)

    if [ "$id" = "$current" ]; then
        die "cannot remove current generation $id"
    fi
    case "$booted" in
        */"$id"|"$SNAPS_SUBVOL/$id")
            die "cannot remove currently-booted generation $id"
            ;;
    esac

    local tl
    tl=$(mount_toplevel)
    btrfs subvolume delete "$tl/$SNAPS_SUBVOL/$id" \
        || { umount "$tl"; rmdir "$tl"; die "failed to delete $id"; }
    umount "$tl"
    rmdir "$tl" 2>/dev/null || true
    rm -f "$SNAP_MOUNT/${id}.meta.toml"

    rewrite_limine
    ok "removed $id"
}

cmd_help() {
    cat <<EOF
chronos : btrfs generation manager for the Haliade system

Usage: chronos <command> [args]

Commands:
  create <description>   Snapshot live root as a new read-only generation
  list                   List generations (* = last created/current)
  current                Show current generation and booted subvolume
  rollback <N>           Roll back to generation N (reboot required)
  remove <N>             Delete a generation
  rewrite-limine         Regenerate /boot/limine.conf
  cleanup-next           Delete staged @.next after a completed rollback
  help                   Show this help

Only create/rollback/remove/rewrite-limine/cleanup-next need superuser
privileges; list, current and help can be run by any user.

Layout:
  @                    live writable root
  @.next               staged rollback target (temporary)
  @snapshots/gen-N     read-only generations

Limine menu:
  /Haliade SYS                              boots live (@ or @.next)
  /Generations//Haliade SYS (Generation N)  boots @snapshots/gen-N

Kernels:
  Each entry boots the kernel its subvolume has modules for. Generations
  keep the kernel they were captured with; the default entry follows the
  subvolume it boots (a staged @.next rollback keeps its own kernel too).
EOF
}

# Dispatch

case "${1:-help}" in
    create)
        shift
        cmd_create "${1:-}"
        ;;
    list)
        cmd_list
        ;;
    current)
        cmd_current
        ;;
    rollback)
        shift
        cmd_rollback "${1:-}"
        ;;
    remove)
        shift
        cmd_remove "${1:-}"
        ;;
    rewrite-limine|rewrite_limine)
        cmd_adopt_if_needed 2>/dev/null || true
        ensure_snapshots_mounted
        rewrite_limine
        ;;

    cleanup-next|cleanup_next)
        cmd_cleanup_next
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo "error: unknown command: ${1:-}" >&2
        cmd_help
        exit 1
        ;;
esac
